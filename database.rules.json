{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['state','updatedAt']) && newData.child('state').isString() && newData.child('updatedAt').isNumber()"
      }
    },
    "matchmaking": {
      "$ticketId": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        ".write": false
      }
    },
    "liveMatches": {
      "$matchId": {
        ".read": "auth != null && data.child('players').child(auth.uid).val() === true",
        ".write": false,
        "commands": {
          "$commandId": {
            ".read": false,
            ".write": false
          }
        }
      }
    }
  }
}
